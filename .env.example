# 这是私人 seminar copilot 的另一套 Slack app token,不要填 seminar-bot 的 token。
COPILOT_SLACK_BOT_TOKEN=xoxb-...
COPILOT_SLACK_APP_TOKEN=xapp-...

# 这个私人 copilot 只响应这个 Slack user。Slack 里点个人资料 -> More -> Copy member ID。
COPILOT_OWNER_USER_ID=U...

# 可选:允许 seminar host bot 触发这个私人 copilot。逗号分隔,可填 U.../W... bot user ID、B... bot ID 或 A... app ID。
# 不要把其他用户的私人 copilot ID 填到这里。
COPILOT_ALLOWED_SEMINAR_BOT_IDS=

# 每个人应该给自己的 Slack app/bot 起不同名字。不要使用 CLAIMED_NAMES.md 里已经声明的名字。
COPILOT_APP_NAME=YourNameCopilot
COPILOT_BOT_DISPLAY_NAME=YourNameCopilot

# 本机大脑:复用 Codex CLI 登录态,不需要额外 LLM API key。
CODEX_BIN=codex
CODEX_EXTRA_ARGS=--skip-git-repo-check
COPILOT_MODEL=

# 本地 watched channel 日志。默认 ./watch,已在项目 .gitignore 中排除。
COPILOT_DATA_DIR=./watch
COPILOT_RECENT_CONTEXT_MESSAGES=50
COPILOT_THREAD_CONTEXT_MESSAGES=80
COPILOT_CONTEXT_CHARS=16000
